# Bashrc addendums for Kraken
# vim: set filetype=sh :

PATH="$HOME/kraken/bin:$PATH"

# Disable git info in 'll' (eza as a replacement for 'ls -l').
# It's too slow in kraken core (1.5 secs).
if command -v eza >/dev/null ; then
    ll() {
        eza --long --no-git --no-quotes --color-scale=age "$@"
    }
fi

# Commented out because some git commands on kraken core repo have made this faster.
# # Disable display of untracked files in 'gs' (git status).
# # It's too slow in Kraken core.
# gs() {
#     git status -uno -s"$@"
# }


## auto activate virtualenvs ------------------

# This is cute, but with uv, do we really need it?

# This could be direnv instead, with a .envrc file of '. .venv/bin/activate'

# I suspect the implementation could just use $VIRTUAL_ENV throughout,
# without needing the $parentdir variable at all.

function cd() {
    builtin cd "$@"

    # If we move out of a previous parentdir, deactivate the previous venv
    if [[ -n "$parentdir" && "$PWD"/ != "$parentdir"/* ]]; then
        deactivate
        unset parentdir
    fi

    # If there is a virtualenv
    if [[ -d ".venv" && -f ".venv/bin/activate" ]]; then
        # activate it
        source ".venv/bin/activate"
        parentdir="$(dirname $VIRTUAL_ENV)"

        # set the terminal name
        termname "$(basename $(dirname $VIRTUAL_ENV))"
    fi
}


## aliases

# post-pull
function pp() {
  inv install-python-deps
  inv localdev.migrate-all --client=championenergy
  inv localdev.migrate-all --client=oeus
}

# pytest: Delegate to 'inv localdev.multi-pytest'
# Args which start with '-' are placed after a final '--'
# Hence args with values must be one word, i.e. '--arg=value' not '--arg value'.
# Other params (without an initial '-') are added as a '--path'
pt() {
    # process args
    paths=""
    extras="--color=yes --no-header "
    errors=false
    for i in "$@"; do
        case "$i" in
            --) ;;
            -*)
                extras="$extras$i "
                ;;
            *)
                if [[ $i == *"tests"* ]]; then
                    paths="$paths$i "
                else
                    error "Arg does not look like a test: $i" >&2
                    errors=true
                fi
                ;;
        esac
    done

    # handle errors
    if [ "$paths" = "" ]; then
        error "No test paths given"
        return
    fi
    if [ $errors = "true" ]; then
        return
    fi

    # construct command
    cmd="invoke localdev.multi-pytest$(echo $paths | xargs -n1 echo -n \ --path)"
    if [ "$extras" != "" ]; then
        cmd="$cmd -- $extras"
    fi

    # print command so user can clipboard it
    echo -e "$(tput bold)$cmd$(tput sgr0)"

    # execute command
    eval etime "$cmd"

    # cleanup
    unset errors extras paths
}

# pytest worktree diffs
ptd() {
    pt $(gtd) -- "$@"
}
# pytest whole branch
ptb() {
    pt $(gtb) -- "$@"
}
# pytest all (tests changed in branch or diffs)
pta() {
    pt $(gtd ; gtb) -- "$@"
}

# typecheck (40 seconds)
# Correcly handles one or more target files or directories.
# Shadows unrelated executable 'tc'.
tc() {
    etime inv run-python-type-checker --territories=usa $(echo $@ | xargs -n1 echo -n ' --target')
}

lint() {
    inv run-python-ruff-linter --fix "$@"
}

format() {
    inv run-python-formatter "$@"
}

lf() {
    lint; format
}


## NVM

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
# Ignore the error if nvm is not installed on this machine
:


## invoke tab-completion

# to be sourced with Bash shell. Known to work on Bash 3.x, untested on 4.x.

_complete_invoke() {
    local candidates

    # COMP_WORDS contains the entire command string up til now (including
    # program name).
    # We hand it to Invoke so it can figure out the current context: spit back
    # core options, task names, the current task's options, or some combo.
    candidates=`invoke --complete -- ${COMP_WORDS[*]}`

    # `compgen -W` takes list of valid options & a partial word & spits back
    # possible matches. Necessary for any partial word completions (vs
    # completions performed when no partial words are present).
    #
    # $2 is the current word or token being tabbed on, either empty string or a
    # partial word, and thus wants to be compgen'd to arrive at some subset of
    # our candidate list which actually matches.
    #
    # COMPREPLY is the list of valid completions handed back to `complete`.
    COMPREPLY=( $(compgen -W "${candidates}" -- $2) )
}

# Tell shell builtin to use the above for completing our invocations.
# * -F: use given function name to generate completions.
# * -o default: when function generates no results, use filenames.
# * positional args: program names to complete for.
complete -F _complete_invoke -o default invoke inv


## env vars

# pre-commit: Skip:
# * running tests, I do that incessantly myself
# * privacy validation: Rarely a problem, leave it to CI
export SKIP=pytest,data-privacy-framework-validation
# Don't do garbage collection iterations looking for resource leaks
# These are rare and will be caught in CI.
export PYTEST_UNRAISABLE_GC_ITERATIONS=0
# Our tricky home-cooked lazy imports save a few secs per test run.
export PY_LAZY_LOADING=1

# Fixes datadog tracebacks at start of running django management commands
export DD_TRACE_ENABLED=false
export DD_DOGSTATSD_DISABLE=1
export DD_APM_TRACING_ENABLED=false

